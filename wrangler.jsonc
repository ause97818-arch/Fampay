{
  "name": "damp-star-72e8",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "LINKS", "id": "PASTE_KV_NAMESPACE_ID_HERE" }
  ]
}
